<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4301" />
  </ItemGroup>

  <!-- ANTLR lexer, parser and visitor are generated into obj on every build -->

  <ItemGroup>
    <Antlr4 Include="Grammar\CellFormula.g4">
      <Package>SpreadsheetApp.Parsing.Grammar</Package>
      <Visitor>true</Visitor>
      <Listener>false</Listener>
    </Antlr4>
  </ItemGroup>

</Project>
